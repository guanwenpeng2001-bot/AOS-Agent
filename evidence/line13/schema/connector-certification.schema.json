{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://aos-agent.invalid/evidence/line13/connector-certification.schema.json",
	"title": "Line 13 connector certification record",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"type",
		"connector",
		"headSha",
		"evidenceClass",
		"state",
		"reasonCode",
		"platform",
		"dependency",
		"authority",
		"checks",
		"safety",
		"source"
	],
	"properties": {
		"schemaVersion": { "const": 1 },
		"type": { "const": "connector_certification" },
		"connector": { "enum": ["acp", "codex_app_server", "claude_agent_sdk"] },
		"headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
		"evidenceClass": { "enum": ["structural_fake", "product_certification"] },
		"state": { "enum": ["passed", "failed", "not_run", "unavailable"] },
		"reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
		"platform": { "type": ["string", "null"], "enum": ["windows", "linux", "macos", null] },
		"dependency": {
			"oneOf": [
				{ "type": "null" },
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["name", "version", "digest"],
					"properties": {
						"name": { "type": "string", "minLength": 1, "maxLength": 120 },
						"version": { "type": "string", "minLength": 1, "maxLength": 120 },
						"digest": { "$ref": "#/$defs/digest" }
					}
				}
			]
		},
		"authority": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "referenceDigest"],
			"properties": {
				"kind": { "enum": ["none", "explicit_isolated"] },
				"referenceDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] }
			}
		},
		"checks": {
			"type": "object",
			"additionalProperties": false,
			"required": ["handshake", "start", "cancel", "resume", "tool"],
			"properties": {
				"handshake": { "$ref": "#/$defs/checkState" },
				"start": { "$ref": "#/$defs/checkState" },
				"cancel": { "$ref": "#/$defs/checkState" },
				"resume": { "$ref": "#/$defs/checkState" },
				"tool": { "$ref": "#/$defs/checkState" }
			}
		},
		"safety": {
			"type": "object",
			"additionalProperties": false,
			"required": ["credentialsPersisted", "promptsPersisted", "pathsPersisted", "transcriptsPersisted"],
			"properties": {
				"credentialsPersisted": { "const": false },
				"promptsPersisted": { "const": false },
				"pathsPersisted": { "const": false },
				"transcriptsPersisted": { "const": false }
			}
		},
		"source": { "enum": ["local_fake_harness", "authorized_external_run", "explicit_absence"] },
		"digest": { "$ref": "#/$defs/digest" }
	},
	"allOf": [
		{
			"if": { "type": "object", "properties": { "state": { "const": "passed" } } },
			"then": {
				"type": "object",
				"properties": {
					"checks": {
						"type": "object",
						"properties": {
							"handshake": { "const": "passed" },
							"start": { "const": "passed" },
							"cancel": { "const": "passed" },
							"resume": { "const": "passed" },
							"tool": { "const": "passed" }
						}
					}
				}
			}
		},
		{
			"if": { "type": "object", "properties": { "state": { "const": "failed" } } },
			"then": {
				"type": "object",
				"properties": {
					"checks": {
						"type": "object",
						"anyOf": [
							{ "type": "object", "properties": { "handshake": { "const": "failed" } } },
							{ "type": "object", "properties": { "start": { "const": "failed" } } },
							{ "type": "object", "properties": { "cancel": { "const": "failed" } } },
							{ "type": "object", "properties": { "resume": { "const": "failed" } } },
							{ "type": "object", "properties": { "tool": { "const": "failed" } } }
						]
					}
				}
			}
		},
		{
			"if": { "type": "object", "properties": { "state": { "const": "not_run" } } },
			"then": { "$ref": "#/$defs/notRunChecks" }
		},
		{
			"if": { "type": "object", "properties": { "state": { "const": "unavailable" } } },
			"then": { "$ref": "#/$defs/unavailableChecks" }
		},
		{
			"if": { "type": "object", "properties": { "evidenceClass": { "const": "structural_fake" } } },
			"then": {
				"type": "object",
				"properties": {
					"source": { "const": "local_fake_harness" },
					"dependency": { "type": "null" },
					"authority": { "type": "object", "properties": { "kind": { "const": "none" }, "referenceDigest": { "type": "null" } } }
				}
			}
		},
		{
			"if": {
				"type": "object",
				"properties": {
					"evidenceClass": { "const": "product_certification" },
					"state": { "enum": ["passed", "failed"] }
				}
			},
			"then": {
				"type": "object",
				"properties": {
					"source": { "const": "authorized_external_run" },
					"platform": { "enum": ["windows", "linux", "macos"] },
					"dependency": { "type": "object" },
					"authority": { "type": "object", "properties": { "kind": { "const": "explicit_isolated" }, "referenceDigest": { "$ref": "#/$defs/digest" } } }
				}
			}
		},
		{
			"if": {
				"type": "object",
				"properties": {
					"evidenceClass": { "const": "product_certification" },
					"state": { "enum": ["not_run", "unavailable"] }
				}
			},
			"then": {
				"type": "object",
				"properties": {
					"source": { "const": "explicit_absence" },
					"platform": { "type": "null" },
					"dependency": { "type": "null" },
					"authority": { "type": "object", "properties": { "kind": { "const": "none" }, "referenceDigest": { "type": "null" } } }
				}
			}
		}
	],
	"$defs": {
		"checkState": { "enum": ["passed", "failed", "not_run", "unavailable"] },
		"digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
		"notRunChecks": {
			"type": "object",
			"properties": {
				"checks": {
					"type": "object",
					"properties": {
						"handshake": { "const": "not_run" },
						"start": { "const": "not_run" },
						"cancel": { "const": "not_run" },
						"resume": { "const": "not_run" },
						"tool": { "const": "not_run" }
					}
				}
			}
		},
		"unavailableChecks": {
			"type": "object",
			"properties": {
				"checks": {
					"type": "object",
					"properties": {
						"handshake": { "const": "unavailable" },
						"start": { "const": "unavailable" },
						"cancel": { "const": "unavailable" },
						"resume": { "const": "unavailable" },
						"tool": { "const": "unavailable" }
					}
				}
			}
		}
	}
}
