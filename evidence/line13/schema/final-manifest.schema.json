{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://aos-agent.invalid/evidence/line13/final-manifest.schema.json",
	"title": "Line 13 exact-head final evidence manifest",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"type",
		"headSha",
		"baseSha",
		"requestedHeadSha",
		"state",
		"ciProvenance",
		"milestoneChain",
		"acOwnerTransitions",
		"qualityGates",
		"knownGaps",
		"platforms",
		"certifications",
		"createdBy"
	],
	"allOf": [
		{
			"if": { "properties": { "state": { "const": "passed" } }, "required": ["state"] },
			"then": { "properties": { "ciProvenance": { "$ref": "#/$defs/ciProvenance" } } }
		}
	],
	"properties": {
		"schemaVersion": { "const": 2 },
		"type": { "const": "line13_final_evidence" },
		"headSha": { "$ref": "#/$defs/headSha" },
		"baseSha": { "$ref": "#/$defs/headSha" },
		"requestedHeadSha": { "$ref": "#/$defs/headSha" },
		"state": { "enum": ["passed", "incomplete"] },
		"ciProvenance": {
			"oneOf": [
				{ "$ref": "#/$defs/ciProvenance" },
				{ "type": "null" }
			]
		},
		"milestoneChain": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schemaVersion", "type", "baseSha", "headSha", "state", "commits", "inputDigest"],
			"properties": {
				"schemaVersion": { "const": 2 },
				"type": { "const": "milestone_chain" },
				"baseSha": { "$ref": "#/$defs/headSha" },
				"headSha": { "$ref": "#/$defs/headSha" },
				"state": { "enum": ["passed", "incomplete"] },
				"commits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/milestoneCommit" } },
				"inputDigest": { "$ref": "#/$defs/digest" }
			}
		},
		"acOwnerTransitions": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schemaVersion", "type", "baseSha", "headSha", "state", "transitions", "inputDigest"],
			"properties": {
				"schemaVersion": { "const": 1 },
				"type": { "const": "ac_owner_transitions" },
				"baseSha": { "$ref": "#/$defs/headSha" },
				"headSha": { "$ref": "#/$defs/headSha" },
				"state": { "enum": ["passed", "incomplete"] },
				"transitions": { "type": "array", "minItems": 24, "maxItems": 24, "items": { "$ref": "#/$defs/acTransition" } },
				"inputDigest": { "$ref": "#/$defs/digest" }
			}
		},
		"qualityGates": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schemaVersion", "type", "headSha", "state", "gates", "inputDigest"],
			"properties": {
				"schemaVersion": { "const": 2 },
				"type": { "const": "quality_gates" },
				"headSha": { "$ref": "#/$defs/headSha" },
				"state": { "enum": ["passed", "incomplete"] },
				"gates": { "type": "array", "minItems": 19, "maxItems": 19, "items": { "$ref": "#/$defs/qualityGate" } },
				"inputDigest": { "$ref": "#/$defs/digest" }
			}
		},
		"knownGaps": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schemaVersion", "type", "headSha", "state", "count", "totalAcceptanceCriteria"],
			"properties": {
				"schemaVersion": { "const": 1 },
				"type": { "const": "known_gaps" },
				"headSha": { "$ref": "#/$defs/headSha" },
				"state": { "enum": ["passed", "failed"] },
				"count": { "type": "integer", "minimum": 0, "maximum": 24 },
				"totalAcceptanceCriteria": { "const": 24 }
			}
		},
		"platforms": { "type": "array", "items": { "type": "object" } },
		"certifications": { "type": "array", "items": { "type": "object" } },
		"createdBy": { "enum": ["repository_verifier", "template"] },
		"digest": { "$ref": "#/$defs/digest" }
	},
	"$defs": {
		"headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
		"digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
		"identity": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "digest"],
			"properties": { "id": { "type": "string" }, "digest": { "$ref": "#/$defs/digest" } }
		},
		"ciArtifactReference": {
			"type": "object",
			"additionalProperties": false,
			"required": ["runId", "artifactId", "digest"],
			"properties": {
				"runId": { "type": "integer", "minimum": 1 },
				"artifactId": { "type": "integer", "minimum": 1 },
				"digest": { "$ref": "#/$defs/digest" }
			}
		},
		"ciProvenance": {
			"type": "object",
			"additionalProperties": false,
			"required": ["schemaVersion", "type", "source", "repository", "baseSha", "headSha", "workflow", "run", "artifact", "digest"],
			"properties": {
				"schemaVersion": { "const": 1 },
				"type": { "const": "ci_provenance" },
				"source": { "const": "github_actions_api" },
				"repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
				"baseSha": { "$ref": "#/$defs/headSha" },
				"headSha": { "$ref": "#/$defs/headSha" },
				"workflow": {
					"type": "object",
					"additionalProperties": false,
					"required": ["id", "path"],
					"properties": {
						"id": { "type": "integer", "minimum": 1 },
						"path": { "type": "string", "pattern": "^\\.github/workflows/[^/@]+\\.ya?ml$" }
					}
				},
				"run": {
					"type": "object",
					"additionalProperties": false,
					"required": ["id", "workflowId", "headSha", "status", "conclusion", "cancelled"],
					"properties": {
						"id": { "type": "integer", "minimum": 1 },
						"workflowId": { "type": "integer", "minimum": 1 },
						"headSha": { "$ref": "#/$defs/headSha" },
						"status": { "const": "completed" },
						"conclusion": { "const": "success" },
						"cancelled": { "const": false }
					}
				},
				"artifact": {
					"type": "object",
					"additionalProperties": false,
					"required": ["id", "name", "runId", "headSha", "digest", "expired"],
					"properties": {
						"id": { "type": "integer", "minimum": 1 },
						"name": { "type": "string", "minLength": 1, "maxLength": 255 },
						"runId": { "type": "integer", "minimum": 1 },
						"headSha": { "$ref": "#/$defs/headSha" },
						"digest": { "$ref": "#/$defs/digest" },
						"expired": { "const": false }
					}
				},
				"digest": { "$ref": "#/$defs/digest" }
			}
		},
		"milestoneCommit": {
			"type": "object",
			"additionalProperties": false,
			"required": ["sequence", "commitSha", "parentSha", "gate", "inputDigest"],
			"properties": {
				"sequence": { "type": "integer", "minimum": 1 },
				"commitSha": { "$ref": "#/$defs/headSha" },
				"parentSha": { "$ref": "#/$defs/headSha" },
				"gate": {
					"type": "object",
					"additionalProperties": false,
					"required": ["state", "cancelled", "command", "ciArtifact"],
					"properties": {
						"state": { "const": "passed" },
						"cancelled": { "const": false },
						"command": { "$ref": "#/$defs/identity" },
						"ciArtifact": { "$ref": "#/$defs/ciArtifactReference" }
					}
				},
				"inputDigest": { "$ref": "#/$defs/digest" }
			}
		},
		"acTransition": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "from", "to", "owner", "commitSha", "headSha", "state", "inputDigest"],
			"properties": {
				"id": { "pattern": "^AC-(0[1-9]|1[0-9]|2[0-4])$" },
				"from": { "const": "open" },
				"to": { "const": "closed" },
				"owner": { "type": "string" },
				"commitSha": { "$ref": "#/$defs/headSha" },
				"headSha": { "$ref": "#/$defs/headSha" },
				"state": { "const": "passed" },
				"inputDigest": { "$ref": "#/$defs/digest" }
			}
		},
		"qualityGate": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "headSha", "state", "cancelled", "command", "ciArtifact", "inputDigest"],
			"properties": {
				"id": { "pattern": "^Q([0-9]|1[0-8])$" },
				"headSha": { "$ref": "#/$defs/headSha" },
				"state": { "const": "passed" },
				"cancelled": { "const": false },
				"command": { "$ref": "#/$defs/identity" },
				"ciArtifact": { "$ref": "#/$defs/ciArtifactReference" },
				"inputDigest": { "$ref": "#/$defs/digest" }
			}
		}
	}
}
